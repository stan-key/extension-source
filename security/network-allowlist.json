{
  "schemaVersion": 1,
  "runtimeFetchOrigins": ["https://api.stan-key.com"],
  "apiHostPermission": "https://api.stan-key.com/*",
  "apiPaths": [
    "POST /v2/extension/session",
    "GET /v2/extension/markets",
    "GET /v2/extension/catalog/manifest",
    "GET /v2/extension/catalog/v/{version}",
    "GET /v2/extension/apps/{appId}/packages/{packageId}/offers",
    "GET /v2/extension/apps/{appId}/packages/{packageId}/prices",
    "POST /v2/extension/apps/{appId}/packages/{packageId}/refresh",
    "POST /v2/extension/analytics/install"
  ],
  "steamPublicReadOrigins": ["https://api.steampowered.com"],
  "steamPublicReads": [
    {
      "path": "GET /IStoreBrowseService/GetItems/v1",
      "caller": "content script on the Steam front page and search pages, under the store.steampowered.com origin",
      "sent": ["App IDs of the visible store tiles", "Steam country code and language declared by the page", "origin=https://store.steampowered.com"],
      "requestPolicy": { "credentials": "omit", "referrerPolicy": "no-referrer", "timeoutMs": 5000, "maxResponseBytes": 524288 },
      "purpose": "read the package that Steam's own best purchase option attaches to a tile price; no host permission is requested for this origin"
    }
  ],
  "userNavigationOrigins": [
    "https://api.stan-key.com",
    "https://stan-key.com",
    "https://chromewebstore.google.com",
    "https://addons.mozilla.org"
  ],
  "requestPolicy": {
    "credentials": "omit",
    "redirect": "error",
    "referrerPolicy": "no-referrer",
    "timeoutMs": 5000,
    "maxResponseBytes": 131072
  },
  "executableCode": {
    "remoteScriptsAllowed": false,
    "dynamicEvaluationAllowed": false,
    "remoteModuleImportsAllowed": false
  }
}
